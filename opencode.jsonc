{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "debug-*": "allow",
      "*": "allow"
    }
  },
  "skill": {
    "auto_trigger": [
      "debug-core",
      "traceability-gate",
      "knowledge-process"
    ],
    "conditional_load": [
      "systems-ml-stack-router",
      "debug-domain-router",
      "debug-deep",
      "debug-fix",
      "debug-verify",
      "porting-toolkit",
      "amd-gpu-stack",
      "nvidia-cuda-stack",
      "vulkan-compute-stack",
      "llm-serving",
      "model-formats",
      "llm-core",
      "llm-advanced",
      "c-systems",
      "linux-kernel-dev",
      "bare-metal-kernel",
      "x86-arch",
      "memory-mgmt",
      "linux-user",
      "windows-user",
      "sys-arch",
      "python-engineering",
      "python-perf",
      "python-conversion",
      "graphics-shader-kernels",
      "optimization-toolkit",
      "architecture-boundaries",
      "low-level-toolkit",
      "utility-pair",
      "sglang-dev",
      "tensorrt-llm-dev",
      "vllm-dev",
      "sherlock-it",
      "ponytail-diag"
    ],
    "trigger_keywords": {
      "systems-ml-stack-router": ["architecture", "cross-platform", "GPU", "kernel", "model format", "toolchain"],
      "implementation-integrity": ["implement", "write code", "fix code", "complete", "production", "stub", "placeholder"],
