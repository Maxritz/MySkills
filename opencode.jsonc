{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "debug-*": "allow",
      "*": "allow"
    }
  },
  "skill": {
    "auto_trigger": [
      "debug-core",
      "code-quality-gate",
      "dev-process",
      "context-tracker",
      "knowledge-base",
      "analysis-log"
    ],
    "conditional_load": [
      "systems-ml-stack-router",
      "debug-domain-router",
      "debug-deep",
      "debug-fix",
      "debug-verify",
      "porting-toolkit",
      "rocm-stack",
      "rocr-runtime",
      "linux-kernel",
      "windows-system-architecture",
      "cuda-stack",
      "directx-ai-ml",
      "python-conversion",
      "python-engineering",
      "c99-systems",
      "cpp-systems",
      "llm-components",
      "system-architecture",
      "memory-management",
      "x86-architecture",
      "graphics-shader-kernels",
      "gguf-format",
      "safetensors-format",
      "modular-component-boundaries",
      "analysis-log",
      "app-engine-deploy",
      "caveman",
      "cdna",
      "kernel-tuning",
      "knowledge-base",
      "llamacpp-dev",
      "llm-hardcode",
      "model-pool",
      "os-kernel",
      "plugin-adapter",
      "ponytail",
      "python-performance",
      "rdna",
      "sglang-dev",
      "tensorrt-llm-dev",
      "vino",
      "vllm-dev",
      "vulkan-compute",
      "linux-systems",
      "sherlock-it",
      "ponytail-diag"
    ],
    "trigger_keywords": {
      "systems-ml-stack-router": ["architecture", "cross-platform", "GPU", "kernel", "model format", "toolchain"],
      "implementation-integrity": ["implement", "write code", "fix code", "complete", "production", "stub", "placeholder"],
      "code-contract-comments": ["comment", "contract", "precondition", "postcondition", "ownership", "Doxygen"],
      "modular-component-boundaries": ["component", "module", "refactor", "interface", "dependency direction"],
      "backend-component-demarcation": ["backend", "service", "repository", "worker", "API layer"],
      "porting-change-isolation": ["port", "adapter", "fallback", "capability probe", "platform delta"],
      "rocm-stack": ["ROCm", "HIP", "rocBLAS", "RCCL", "rocprof", "rocminfo"],
      "rocr-runtime": ["ROCr", "HSA", "AQL", "hsa_init", "queue", "signal"],
      "linux-kernel": ["Linux kernel", "Kconfig", "module", "driver", "DMA", "ftrace"],
      "windows-system-architecture": ["Windows internals", "Win32", "WDDM", "ETW", "WinDbg", "handle"],
      "cuda-stack": ["CUDA", "nvcc", "CUDA graph", "stream", "Nsight", "kernel launch"],
      "directx-ai-ml": ["DirectX", "D3D12", "DirectML", "Agility SDK", "DXGI", "DXIL"],
      "graphics-shader-kernels": ["shader", "HLSL", "GLSL", "SPIR-V", "subgroup", "barrier"],
      "llm-components": ["attention", "KV cache", "tokenizer", "MoE", "sampling", "speculative decoding"],
      "gguf-format": ["GGUF", "ggml", "quantization", "tensor offsets"],
      "safetensors-format": ["SafeTensors", "safetensors", "tensor shards", "mmap"],
      "cross-compilation": ["cross-compile", "sysroot", "target triple", "toolchain file", "ABI"],
      "toolchains": ["compiler", "linker", "assembler", "CMake", "Ninja", "SDK"],
      "x86-architecture": ["x86", "x86-64", "AVX", "CPUID", "paging", "cache"],
      "emulation": ["emulator", "simulation", "JIT", "binary translation", "snapshot", "deterministic replay"],
      "debug-core": ["debug", "reproduce", "root cause", "hypothesis", "fix", "verify", "trace"],
      "debug-deep": ["deep debug", "fishbone", "fault tree", "5 whys", "barrier analysis", "change analysis", "waterfall trace"],
      "debug-fix": ["apply fix", "minimal patch", "root cause fix"],
      "debug-verify": ["verify fix", "validation", "regression test", "differential test"],
      "debug-domain-router": ["domain debug", "specialized debug", "C++ debug", "GPU debug", "LLM debug"],
      "code-quality-gate": ["quality gate", "Doxygen", "contracts", "validation", "traceability", "Rust safety", "component boundaries"],
      "porting-toolkit": ["port", "cross-compile", "cross-platform", "adapter", "capability probe", "platform delta", "emulation", "toolchain", "assembly"],
      "sherlock-it": ["performance", "profile", "bottleneck", "optimize", "benchmark", "trap"],
      "ponytail-diag": ["diagnose", "one-line verdict", "truth table", "hypothesis", "root cause"]
    }
  }
}