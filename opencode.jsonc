      "porting-change-isolation": ["port", "adapter", "fallback", "capability probe", "platform delta"],
      "amd-gpu-stack": ["AMD GPU", "ROCm", "HIP", "HSA", "ROCr", "CDNA", "RDNA", "MI200", "MI300", "RX 6000", "RX 7000", "rocBLAS", "RCCL", "rocprof", "rocminfo"],
