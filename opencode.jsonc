      "llm-advanced": ["MoE", "Mixture of Experts", "speculative decoding", "Medusa", "EAGLE", "router", "expert", "shared experts", "numerical tolerances", "INT4", "AWQ", "GPTQ"],
      "c-systems": ["C99", "C++", "RAII", "ABI", "ownership", "lifetime", "allocator", "concurrency", "template", "systems code", "portable C", "performance contract"],
